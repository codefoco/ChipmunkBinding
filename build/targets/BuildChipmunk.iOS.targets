<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <iOSBuildDir>ios_build</iOSBuildDir>
        <iOSOutputDir>ios</iOSOutputDir>
        <iOSSimulatorX64OutputDir>iossimulator-x64</iOSSimulatorX64OutputDir>
        <iOSSimulatorArm64OutputDir>iossimulator-arm64</iOSSimulatorArm64OutputDir>
        <DylibFileFramework>libchipmunk.framework</DylibFileFramework>
    </PropertyGroup>
    <Target Name="BuildChipmunkXamariniOS" BeforeTargets="PrepareForBuild" Condition="'$(OS)'=='Unix' and Exists('/usr/bin/xcodebuild')" >
        <Message Text="Building iOS Chipmunk library (device + simulator split)" />
        <Exec Command="make ios iossimulator-x64 iossimulator-arm64" WorkingDirectory="$(ExternalChipmunkPath)/$(iOSBuildDir)" />
        <Exec Command="ditto $(ExternalChipmunkPath)/$(iOSBuildDir)/$(iOSOutputDir)/$(DylibFileFramework) $(OutputRuntimeDir)/$(iOSOutputDir)/native/$(DylibFileFramework)"  />
        <Exec Command="ditto $(ExternalChipmunkPath)/$(iOSBuildDir)/$(iOSSimulatorX64OutputDir)/$(DylibFileFramework) $(OutputRuntimeDir)/$(iOSSimulatorX64OutputDir)/native/$(DylibFileFramework)"  />
        <Exec Command="ditto $(ExternalChipmunkPath)/$(iOSBuildDir)/$(iOSSimulatorArm64OutputDir)/$(DylibFileFramework) $(OutputRuntimeDir)/$(iOSSimulatorArm64OutputDir)/native/$(DylibFileFramework)"  />
        <RemoveDir Directories="$(OutputRuntimeDir)/$(iOSOutputDir)/native/$(DylibFileFramework)/Headers" />
        <RemoveDir Directories="$(OutputRuntimeDir)/$(iOSSimulatorX64OutputDir)/native/$(DylibFileFramework)/Headers" />
        <RemoveDir Directories="$(OutputRuntimeDir)/$(iOSSimulatorArm64OutputDir)/native/$(DylibFileFramework)/Headers" />
    </Target>
    <Target Name="CleanChipmunkXamariniOS" AfterTargets="Clean" Condition="'$(OS)'=='Unix' and Exists('/usr/bin/xcodebuild')" >
        <Message Text="Cleaning Chipmunk library (iOS)" />
        <RemoveDir Directories="
        $(ExternalChipmunkPath)/$(iOSBuildDir)/$(iOSOutputDir);
        $(ExternalChipmunkPath)/$(iOSBuildDir)/$(iOSSimulatorX64OutputDir);
        $(ExternalChipmunkPath)/$(iOSBuildDir)/$(iOSSimulatorArm64OutputDir);
        $(OutputRuntimeDir)/$(iOSOutputDir);
        $(OutputRuntimeDir)/$(iOSSimulatorX64OutputDir);
        $(OutputRuntimeDir)/$(iOSSimulatorArm64OutputDir) " />
    </Target>
</Project>

